__pycache__/
*.pyc
build/
build_*/
dist/
dist_*/
*.spec
*.exe
_adv_tmp/
_pytest_tmp/
# publish.py 必须入库：tests/unit 有两个模块级 import 它，CI 检出后缺它就在收集期
# ModuleNotFoundError，整个单元层直接红（R749 的实测就是 2026-10-29 起每次 CI 全红）。
# 它不含任何凭据——token 由 release_token.py 的查找链在运行时取。
drag_probe.py
*.bak-*
# ONNX 语义编码器权重（24MB 二进制，R861）：由 tools/export_onnx_r861.py 生成、
# cli.py deploy 粘性带进 ~/.agenthub/mcp_server/models/；不入库也不进 exe 包。
# 不入库的原因和 *.exe 一样：二进制体积不该进版本历史。
models/
output/
..output*
# 并行 agent 在本仓库里的私有记忆/自动化目录：不是 AgentHub 源码，
# 但 `git status --porcelain` 会把它算成脏，直接顶掉构建溯源门（dirty=true 拒绝发布）。
.workbuddy/
/g1/
/tg/
